 namespace odin {
 
+/* The memory of the code on Windows (P04). Unset: VirtualAlloc with
+ * PAGE_EXECUTE_READWRITE, as upstream. A host that must go through a
+ * different API sets them before the first HostCode is made: code_alloc
+ * gives size bytes at address at (0: anywhere), readable, writable and
+ * executable, or nullptr; code_free gives them back. The Xbox DLL uses
+ * VirtualAllocFromApp and VirtualProtectFromApp (odin_c.cpp). */
+using CodeAlloc = uint8_t *(*)(uintptr_t at, uint32_t size);
+using CodeFree = void (*)(uint8_t *code, uint32_t size);
+inline CodeAlloc code_alloc = nullptr;
+inline CodeFree code_free = nullptr;
+
