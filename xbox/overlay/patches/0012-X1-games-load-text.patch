+/* X1 (not in upstream): the list from memory, for a host that embeds
+ * odin-games.json in its DLL (the Xbox core). The same checks as load. */
+bool
+GameList::load_text(const std::string &name, const char *text, size_t size)
+{
+	json_error_t error;
+
+	if (m_root)
+		json_decref(m_root);
+	m_root = json_loadb(text, size, 0, &error);
+	if (!m_root) {
+		std::fprintf(stderr, "ERROR: can't load game list '%s': %s (line %d, column %d)\n", name.c_str(),
+		             error.text, error.line, error.column);
+		return false;
+	}
+	return check();
+}
