 /* What the LZMA SDK reads ahead of the archive at a time, as its example */
 constexpr size_t LOOK_AHEAD = size_t{1} << 18;
 
+/* The LZMA SDK's stream over a FILE* of odin::io (P05): the LZMA SDK's own
+ * file functions are not used (they open by name, without the broker).
+ * vt comes first, so that a pointer to it is a pointer to the stream. */
+struct FileStream {
+	ISeekInStream vt;
+	std::FILE *file;
+};
+
+SRes
+file_read(ISeekInStreamPtr p, void *buf, size_t *size)
+{
+	const FileStream *const stream = reinterpret_cast<const FileStream *>(p);
+	const size_t want = *size;
+
+	*size = want ? std::fread(buf, 1, want, stream->file) : 0;
+	return std::ferror(stream->file) ? SZ_ERROR_READ : SZ_OK;
+}
+
+SRes
+file_seek(ISeekInStreamPtr p, Int64 *pos, ESzSeek origin)
+{
+	const FileStream *const stream = reinterpret_cast<const FileStream *>(p);
+	const int whence = origin == SZ_SEEK_SET ? SEEK_SET : origin == SZ_SEEK_CUR ? SEEK_CUR : SEEK_END;
+
+	if (_fseeki64(stream->file, static_cast<long long>(*pos), whence) != 0)
+		return SZ_ERROR_READ;
+	*pos = static_cast<Int64>(_ftelli64(stream->file));
+	return SZ_OK;
+}
