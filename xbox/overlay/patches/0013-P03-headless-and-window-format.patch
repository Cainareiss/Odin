+/* P03 (M3): the card with no window. The loader entry comes from the host
+ * (odin_set_vulkan_icd): the DLL never loads an ICD by itself. */
+namespace {
+PFN_vkGetInstanceProcAddr g_headless_entry = nullptr;
+} /* namespace */
+
+void
+set_headless_loader(PFN_vkGetInstanceProcAddr entry)
+{
+	g_headless_entry = entry;
+}
+
+std::unique_ptr<Context>
+Context::make_headless(const std::string &gpu, std::string &why)
+{
+	std::unique_ptr<Context> card(new Context());
+
+	card->m_headless = true;
+	card->m_validation = env_flag("ODIN_VK_VALIDATION");
+	if (!card->load(why) || !card->make_instance(why))
+		return nullptr;
+	if (!card->choose_gpu(gpu, why) || !card->make_device(why))
+		return nullptr;
+	return card;
+}
